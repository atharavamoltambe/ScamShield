# Configures whether the external LLM explanation layer is enabled (true/false)
LLM_ENABLED=false

# API Key for the LLM Provider
# For Gemini: Use a Google AI Studio API Key (starts with AIzaSy)
# For OpenAI: Use an OpenAI API Key (starts with sk-)
LLM_API_KEY=

# Model identifier to use.
# Defaults:
# - Gemini: gemini-3.5-flash
# - OpenAI: gpt-4o-mini
LLM_MODEL=gemini-3.5-flash

# Explicitly set the provider (gemini or openai)
# If left blank, it will auto-detect from the LLM_API_KEY prefix
LLM_PROVIDER=
